GRAPHSCOPE_NEO4J_URI=bolt://localhost:7687
GRAPHSCOPE_NEO4J_USER=neo4j
GRAPHSCOPE_NEO4J_PASSWORD=neo4j
GRAPHSCOPE_DEFAULT_GROUP_ID=
GRAPHSCOPE_CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]
GRAPHSCOPE_CACHE_TTL_SECONDS=300
GRAPHSCOPE_SHORTEST_PATH_CUTOFF=6

# LLM 配置（用于本体生成和图谱构建）
GRAPHSCOPE_LLM_API_KEY=
GRAPHSCOPE_LLM_BASE_URL=https://api.openai.com/v1
GRAPHSCOPE_LLM_MODEL_NAME=gpt-4o-mini

# Embedding 模型（本地 sentence-transformers）
GRAPHSCOPE_EMBEDDING_MODEL=all-MiniLM-L6-v2

# 文件上传
GRAPHSCOPE_UPLOAD_DIR=uploads
GRAPHSCOPE_MAX_UPLOAD_SIZE_MB=50
